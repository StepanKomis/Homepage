# Environment Configuration
# Copy to .env and .env.local, update with your values

# ─ Core Configuration
TZ=Europe/Prague
LANG=cs
NODE_ENV=development

# ─ Database
DATABASE_URL=postgres://homepage:homepage@localhost:5432/homepage
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=homepage
DATABASE_PASSWORD=homepage
DATABASE_NAME=homepage

# ─ Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=4200
BACKEND_URL=http://localhost:4200

# ─ Frontend
FRONTEND_PORT=5173
FRONTEND_URL=http://localhost:5173

# ─ Integrations
# Uptime Kuma
UPTIME_KUMA_URL=http://kuma.komis.cz:3001
UPTIME_KUMA_API_KEY=

# Jellyfin
JELLYFIN_URL=http://jellyfin.komis.cz:8096
JELLYFIN_API_KEY=

# Sonarr
SONARR_URL=http://sonarr.komis.cz:8989
SONARR_API_KEY=

# Radarr
RADARR_URL=http://radarr.komis.cz:7878
RADARR_API_KEY=

# Bazarr
BAZARR_URL=http://bazarr.komis.cz:6767
BAZARR_API_KEY=

# Audiobookshelf
AUDIOBOOKSHELF_URL=http://abs.komis.cz:13378
AUDIOBOOKSHELF_API_KEY=

# Honcho
HONCHO_URL=http://honcho.komis.cz:8666
HONCHO_API_KEY=

# MongoDB (mongo2)
MONGO_URL=mongodb://mongo2.komis.cz:27017

# ─ WebSocket
WS_URL=ws://localhost:4200/api/ws
WS_HEARTBEAT_INTERVAL=30000

# ─ Logging
LOG_LEVEL=info
